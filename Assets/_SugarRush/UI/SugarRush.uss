:root {
    --pink: #FF8FC7;
    --pink-light: #FFC2E0;
    --pink-dark: #D9579A;
    --mint: #7EDDBF;
    --mint-light: #B5F0DD;
    --mint-dark: #3FAE8A;
    --lavender: #C3A3FF;
    --lavender-light: #E0D0FF;
    --lavender-dark: #8E66DB;
    --lemon: #FFE07A;
    --lemon-light: #FFF0B8;
    --lemon-dark: #D9A93A;
    --sky: #8FD3FF;
    --sky-light: #C7EAFF;
    --sky-dark: #4E9FD6;
    --cream: #FFF7FB;
    --choco: #5A3248;
    -unity-font: url("project://database/Assets/_SugarRush/UI/Fonts/Fredoka-SemiBold.ttf");
    color: var(--choco);
    font-size: 32px;
}

/* ---------- Layout ---------- */

/* Without Unity's default theme the document root must be stretched explicitly. */
.unity-ui-document__root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    transition-duration: 0.32s;
    transition-timing-function: ease-out-back;
}

.screen--entering {
    opacity: 0;
    scale: 0.9 0.9;
    translate: 0 50px;
    transition-duration: 0s;
}

.screen--leaving {
    opacity: 0;
    scale: 1.06 1.06;
    transition-duration: 0.2s;
    transition-timing-function: ease-in;
}

.screen--left {
    align-items: flex-start;
    padding-left: 110px;
}

.screen--dim {
    background-color: rgba(90, 50, 72, 0.45);
}

.menu-column {
    align-items: center;
}

.hidden {
    display: none;
}

.row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.sprinkle-rain {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Scene curtain: pink with sprinkles, fades away on scene start and back in before loading. */
.fader {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--pink-light);
    transition-duration: 0.38s;
    transition-timing-function: ease-in-out-sine;
}

.fader--clear {
    opacity: 0;
}

.pop {
    scale: 1.8 1.8;
    opacity: 0;
    transition-duration: 0s;
}

/* ---------- Candy titles ---------- */

.candy-title {
    -unity-font: url("project://database/Assets/_SugarRush/UI/Fonts/LuckiestGuy-Regular.ttf");
    transition-duration: 0.4s;
    transition-timing-function: ease-out-back;
}

.candy-title > Label {
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0 12px;
    color: #FFFFFF;
    -unity-text-outline-color: #FFFFFF;
    white-space: nowrap;
}

.candy-title__shadow {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
}

.candy-title__gloss {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 50%;
    overflow: hidden;
}

.candy-title__gloss-text {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    margin: 0;
    padding: 0 12px;
    -unity-text-align: middle-center;
    color: rgba(255, 255, 255, 0.42);
    white-space: nowrap;
}

/* Sizes: font, outline thickness and shadow depth grow together. */
.candy-title--xxl > Label,
.candy-title--xxl .candy-title__gloss-text {
    font-size: 260px;
}

.candy-title--xxl > Label {
    -unity-text-outline-width: 12px;
}

.candy-title--xxl > .candy-title__shadow {
    translate: 0 16px;
}

.candy-title--xl > Label,
.candy-title--xl .candy-title__gloss-text {
    font-size: 150px;
}

.candy-title--xl > Label {
    -unity-text-outline-width: 9px;
}

.candy-title--xl > .candy-title__shadow {
    translate: 0 11px;
}

.candy-title--lg > Label,
.candy-title--lg .candy-title__gloss-text {
    font-size: 100px;
}

.candy-title--lg > Label {
    -unity-text-outline-width: 7px;
}

.candy-title--lg > .candy-title__shadow {
    translate: 0 8px;
}

.candy-title--md > Label,
.candy-title--md .candy-title__gloss-text {
    font-size: 70px;
}

.candy-title--md > Label {
    -unity-text-outline-width: 5px;
}

.candy-title--md > .candy-title__shadow {
    translate: 0 6px;
}

.candy-title--sm > Label,
.candy-title--sm .candy-title__gloss-text {
    font-size: 48px;
}

.candy-title--sm > Label {
    -unity-text-outline-width: 4px;
}

.candy-title--sm > .candy-title__shadow {
    translate: 0 4px;
}

/* Tones: letter colour + matching dark shadow. */
.candy-title > .candy-title__shadow {
    color: var(--lavender-dark);
    -unity-text-outline-color: var(--lavender-dark);
}

.candy-title--pink > .candy-title__text {
    color: var(--pink);
}

.candy-title--pink > .candy-title__shadow {
    color: var(--pink-dark);
    -unity-text-outline-color: var(--pink-dark);
}

.candy-title--mint > .candy-title__text {
    color: var(--mint);
}

.candy-title--mint > .candy-title__shadow {
    color: var(--mint-dark);
    -unity-text-outline-color: var(--mint-dark);
}

.candy-title--lavender > .candy-title__text {
    color: var(--lavender);
}

.candy-title--lavender > .candy-title__shadow {
    color: var(--lavender-dark);
    -unity-text-outline-color: var(--lavender-dark);
}

.candy-title--lemon > .candy-title__text {
    color: var(--lemon);
}

.candy-title--lemon > .candy-title__shadow {
    color: #E0405F;
    -unity-text-outline-color: #E0405F;
}

.candy-title--sky > .candy-title__text {
    color: var(--sky);
}

.candy-title--sky > .candy-title__shadow {
    color: var(--sky-dark);
    -unity-text-outline-color: var(--sky-dark);
}

.subtitle {
    font-size: 40px;
    color: #FFFFFF;
    -unity-font: url("project://database/Assets/_SugarRush/UI/Fonts/Fredoka-Bold.ttf");
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: var(--lavender-dark);
    text-shadow: 0 4px 0 rgba(90, 50, 72, 0.5);
    margin: 6px 0 26px 0;
    -unity-text-align: middle-center;
}

.small-text {
    font-size: 24px;
    color: #FFFFFF;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: var(--choco);
    -unity-text-align: middle-center;
    white-space: normal;
}

.footer {
    position: absolute;
    left: 40px;
    right: 40px;
    bottom: 16px;
}

/* ---------- Frosting panels ---------- */

.frosting-panel {
    padding: 88px 64px 44px 64px;
    align-items: center;
}

.frosting-panel--wide {
    min-width: 920px;
}

.frosting-panel--compact {
    padding: 64px 44px 26px 44px;
}

.panel-heading {
    margin-bottom: 14px;
}

/* ---------- Candy buttons ---------- */

.candy-button {
    width: 600px;
    height: 100px;
    margin: 10px 0;
    padding: 0;
    border-radius: 50px;
    border-width: 6px 6px 14px 6px;
    border-color: #FFFFFF;
    background-color: var(--pink);
    overflow: hidden;
    justify-content: center;
    transition-duration: 0.45s;
    transition-timing-function: ease-out-elastic;
}

.candy-button:hover,
.candy-button:focus {
    scale: 1.08 1.08;
    border-color: var(--lemon-light);
}

.candy-button:active {
    scale: 0.94 0.94;
    border-bottom-width: 8px;
    transition-duration: 0.08s;
}

.candy-button__stripes {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    opacity: 0;
    transition-duration: 0.2s;
}

.candy-button:hover > .candy-button__stripes,
.candy-button:focus > .candy-button__stripes {
    opacity: 1;
}

.candy-button__gloss {
    position: absolute;
    left: 6%;
    right: 6%;
    top: 7px;
    height: 34%;
    border-radius: 30px;
    background-color: rgba(255, 255, 255, 0.42);
}

.candy-button__label {
    -unity-font: url("project://database/Assets/_SugarRush/UI/Fonts/Fredoka-Bold.ttf");
    font-size: 46px;
    color: #FFFFFF;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgba(90, 50, 72, 0.55);
    text-shadow: 0 3px 0 rgba(90, 50, 72, 0.35);
    margin: 0;
    padding: 0;
}

.candy-button--mint {
    background-color: var(--mint);
}

.candy-button--lavender {
    background-color: var(--lavender);
}

.candy-button--lemon {
    background-color: var(--lemon);
}

.candy-button--lemon > .candy-button__label {
    color: var(--choco);
    -unity-text-outline-width: 0;
    text-shadow: 0 2px 0 rgba(255, 255, 255, 0.6);
}

.candy-button--pink-light {
    background-color: #FFA3CF;
}

/* Main menu column: six buttons have to fit under the title. */
.candy-button--menu {
    height: 88px;
    margin: 7px 0;
}

/* Long labels ("2 jugadores (misma pantalla)") stay on one line. */
.candy-button--long > .candy-button__label {
    font-size: 34px;
}

.candy-button--small {
    width: 380px;
    height: 84px;
    margin: 10px 12px;
}

.candy-button--small > .candy-button__label {
    font-size: 38px;
}

/* ---------- Peppermint arrows ---------- */

.peppermint-button {
    width: 104px;
    height: 104px;
    margin: 0 16px;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    justify-content: center;
    transition-duration: 0.45s;
    transition-timing-function: ease-out-elastic;
}

.peppermint-button:hover {
    scale: 1.15 1.15;
}

.peppermint-button:active {
    scale: 0.9 0.9;
    transition-duration: 0.08s;
}

.peppermint-disc {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    transition-duration: 0.6s;
    transition-timing-function: ease-out-back;
}

.peppermint-button:hover > .peppermint-disc {
    rotate: 135deg;
}

.chevron-glyph {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.peppermint-button--small {
    width: 76px;
    height: 76px;
    margin: 0 10px;
}

/* ---------- Options ---------- */

.option-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 840px;
    margin: 6px 0;
    padding: 4px 18px 4px 32px;
    border-radius: 44px;
    border-width: 4px;
    border-color: rgba(255, 255, 255, 0);
    background-color: rgba(195, 163, 255, 0.18);
    transition-duration: 0.3s;
    transition-timing-function: ease-out-back;
}

.option-row:focus {
    background-color: rgba(255, 143, 199, 0.3);
    border-color: var(--pink-light);
    scale: 1.03 1.03;
}

.option-row__label {
    font-size: 40px;
    color: var(--choco);
}

.option-row__value {
    -unity-font: url("project://database/Assets/_SugarRush/UI/Fonts/Fredoka-Bold.ttf");
    font-size: 40px;
    color: var(--pink-dark);
    min-width: 260px;
    -unity-text-align: middle-center;
}

/* ---------- Character select ---------- */

.char-name-row {
    margin: 4px 0 18px 0;
}

.char-name {
    min-width: 560px;
}

.stat-row {
    flex-direction: row;
    align-items: center;
    width: 640px;
    margin: 7px 0;
}

.stat-row__label {
    width: 250px;
    font-size: 32px;
}

.stat-bar {
    flex-grow: 1;
    height: 32px;
    border-radius: 16px;
    border-width: 4px;
    border-color: #FFFFFF;
    background-color: rgba(90, 50, 72, 0.12);
    overflow: hidden;
}

.stat-bar__fill {
    height: 100%;
    border-radius: 12px;
    background-color: var(--pink);
    overflow: hidden;
    transition-duration: 0.5s;
    transition-timing-function: ease-out-back;
}

.stat-bar__fill--mint {
    background-color: var(--mint);
}

.stat-bar__fill--lavender {
    background-color: var(--lavender);
}

.stat-bar__stripes {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* ---------- Candy chips (HUD) ---------- */

.candy-chip {
    background-color: var(--cream);
    border-width: 5px 5px 9px 5px;
    border-color: #FFFFFF;
    border-radius: 34px;
    padding: 2px 30px;
    margin: 6px 0;
    overflow: hidden;
}

.candy-chip__gloss {
    position: absolute;
    left: 8%;
    right: 8%;
    top: 4px;
    height: 30%;
    border-radius: 20px;
    background-color: rgba(255, 255, 255, 0.85);
}

.candy-chip__label {
    -unity-font: url("project://database/Assets/_SugarRush/UI/Fonts/Fredoka-Bold.ttf");
    font-size: 40px;
    color: var(--choco);
    margin: 0;
}

.candy-chip--lap {
    background-color: var(--lavender-light);
}

.candy-chip--lap > .candy-chip__label {
    color: var(--lavender-dark);
}

.candy-chip--time {
    background-color: var(--mint-light);
}

.candy-chip--time > .candy-chip__label {
    color: var(--mint-dark);
}

/* ---------- HUD ---------- */

.hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hud-corner {
    position: absolute;
    align-items: flex-start;
}

.hud-corner--top-left {
    left: 26px;
    top: 36px;
}

.hud-corner--top-right {
    right: 36px;
    top: 28px;
    align-items: flex-end;
}

.hud-corner--bottom-right {
    right: 30px;
    bottom: 18px;
    align-items: flex-end;
}

.hud-corner--bottom-left {
    left: 36px;
    bottom: 24px;
}

.hud-row {
    flex-direction: row;
    align-items: flex-end;
}

.hud-row > * {
    flex-shrink: 0;
}

.hud-speed {
    min-width: 190px;
}

.hud-unit {
    -unity-font: url("project://database/Assets/_SugarRush/UI/Fonts/Fredoka-Bold.ttf");
    font-size: 36px;
    color: #FFFFFF;
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: var(--sky-dark);
    margin: 0 0 26px -6px;
}

.hud-total {
    margin-bottom: 18px;
    margin-left: -30px;
}

.hud-center {
    position: absolute;
    left: 0;
    right: 0;
    top: 18%;
    align-items: center;
}

.hud-lost {
    margin-top: 12px;
    max-width: 1200px;
}

.hud-lost__text {
    font-size: 36px;
    color: var(--choco);
    -unity-text-align: middle-center;
    white-space: normal;
}

/* ---------- Online ---------- */

.candy-button--sky {
    background-color: var(--sky);
}

.candy-input {
    width: 360px;
    height: 96px;
    margin: 10px 12px;
}

.candy-input > .unity-base-text-field__input,
.candy-input > .unity-text-field__input {
    background-color: #FFFFFF;
    border-width: 6px;
    border-color: var(--sky);
    border-radius: 48px;
    padding: 0 20px;
    -unity-font: url("project://database/Assets/_SugarRush/UI/Fonts/LuckiestGuy-Regular.ttf");
    font-size: 52px;
    color: var(--choco);
    letter-spacing: 6px;
    -unity-text-align: middle-center;
    --unity-cursor-color: var(--pink-dark);
    --unity-selection-color: var(--pink-light);
}

.candy-input:focus > .unity-base-text-field__input,
.candy-input:focus > .unity-text-field__input {
    border-color: var(--pink);
}

.online-status {
    font-size: 32px;
    color: var(--pink-dark);
    margin-top: 8px;
    min-height: 44px;
    -unity-text-align: middle-center;
    white-space: normal;
    max-width: 800px;
}

.room-code {
    margin: 0 0 4px 0;
}

.panel-note {
    font-size: 28px;
    color: var(--lavender-dark);
    -unity-text-align: middle-center;
    margin-bottom: 12px;
}

.menu-message {
    font-size: 32px;
    color: #FFFFFF;
    background-color: rgba(217, 87, 154, 0.9);
    border-radius: 30px;
    border-width: 4px;
    border-color: #FFFFFF;
    padding: 8px 28px;
    margin-top: 12px;
    white-space: normal;
    max-width: 640px;
    -unity-text-align: middle-center;
}

.lobby-pick {
    margin: 4px 0 8px 0;
}

.lobby-pick__name {
    min-width: 440px;
}

/* ---------- Split screen ---------- */

.hud--left {
    right: 50%;
}

.hud--right {
    left: 50%;
}

.hud-center--player {
    top: 36%;
}

.split-divider {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 8px;
    margin-left: -4px;
    background-color: #FFFFFF;
    border-left-width: 2px;
    border-right-width: 2px;
    border-color: var(--pink);
}

.local-slots {
    flex-direction: row;
    justify-content: center;
}

.local-slot {
    width: 560px;
    margin: 0 150px;
    padding-top: 46px;
    padding-bottom: 14px;
}

.local-slot__device {
    font-size: 32px;
    color: var(--lavender-dark);
    -unity-text-align: middle-center;
    margin-bottom: 6px;
}

.local-slot__status {
    font-size: 40px;
    color: var(--mint-dark);
    -unity-font: url("project://database/Assets/_SugarRush/UI/Fonts/Fredoka-Bold.ttf");
    -unity-text-align: middle-center;
    margin-top: 4px;
}

.local-slot__waiting {
    font-size: 36px;
    color: var(--choco);
    -unity-text-align: middle-center;
    white-space: normal;
    margin: 18px 0;
}

.local-slot--ready {
    scale: 1.03 1.03;
}

.results-place {
    margin: 0 24px;
}

/* ---------- Results ---------- */

.results-row {
    flex-direction: row;
    align-items: center;
    width: 840px;
    margin: 4px 0;
    padding: 2px 28px;
    border-radius: 32px;
    border-width: 4px;
    border-color: rgba(255, 255, 255, 0.9);
    background-color: rgba(195, 163, 255, 0.2);
}

.results-row--player {
    background-color: var(--lemon-light);
    border-color: var(--lemon);
}

.results-row__pos {
    -unity-font: url("project://database/Assets/_SugarRush/UI/Fonts/LuckiestGuy-Regular.ttf");
    width: 110px;
    font-size: 44px;
    color: var(--pink-dark);
}

.results-row__name {
    flex-grow: 1;
    font-size: 38px;
}

.results-row__time {
    -unity-font: url("project://database/Assets/_SugarRush/UI/Fonts/Fredoka-Bold.ttf");
    font-size: 38px;
    color: var(--lavender-dark);
}

.results-highlight {
    -unity-font: url("project://database/Assets/_SugarRush/UI/Fonts/Fredoka-Bold.ttf");
    font-size: 44px;
    color: var(--mint-dark);
    margin: 8px 0 4px 0;
}

/* Online page: "Create room" next to the private / public switch. */
.create-row {
    align-items: center;
    justify-content: center;
    margin-bottom: 6px;
}

.create-row > .option-row {
    width: 440px;
    margin-left: 20px;
    padding-left: 26px;
}

/* Waiting room: "we made a room for you" / "found a room" after a quick match. */
.lobby-notice {
    font-size: 28px;
    margin-top: 2px;
    margin-bottom: 14px;
}

/* ---- Ralph's chaos ---- */
.hud-banner {
    position: absolute;
    left: 0;
    right: 0;
    top: 9%;
    align-items: center;
}

.coin-row {
    align-items: center;
    margin-top: 6px;
}

.coin-icon {
    width: 40px;
    height: 40px;
    border-radius: 20px;
    background-color: #FFC83D;
    border-width: 5px;
    border-color: #FFF1A8;
    margin-right: 8px;
}

.candy-chip--coins {
    background-color: #FFE0F0;
}

.candy-chip--coins > .candy-chip__label {
    color: #C2307A;
}

.coin-row__hammer {
    margin-left: 12px;
}

/* ---- Results podium (stage D) ---- */
.results-layout {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.results-podium {
    width: 600px;
    height: 450px;
    margin-right: 24px;
    border-radius: 40px;
    border-width: 8px;
    border-color: #FFFFFF;
    background-color: #FFDDEB;
}

/* ---- Two-player page: picks in 3D in the middle, panels below (stage 5) ---- */
.screen--local {
    justify-content: flex-start;
    padding: 36px 0 28px 0;
}

.local-spacer {
    flex-grow: 1;
}

.local-footer {
    align-items: center;
    margin-top: 12px;
}

.local-hints {
    align-items: center;
    margin: 0 24px 0 0;
    padding: 8px 34px;
    border-radius: 30px;
    background-color: rgba(92, 46, 98, 0.82);
}

.local-hint {
    font-size: 34px;
    color: #FFFFFF;
    -unity-font: url("project://database/Assets/_SugarRush/UI/Fonts/Fredoka-Bold.ttf");
    -unity-text-align: middle-center;
}

.local-hint--small {
    font-size: 26px;
    color: #FFE6F3;
}

/* Wrapped candy icon next to the candies counter (point 4). */
.candy-icon {
    width: 64px;
    height: 40px;
    margin-right: 6px;
}

/* ---- Main menu layout (point 3): big Play, 2x2 tiles, small Quit ---- */
.candy-button--hero {
    width: 600px;
    height: 128px;
    margin: 4px 0 22px 0;
}

.candy-button--hero > .candy-button__label {
    font-size: 66px;
}

.menu-tiles {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    width: 640px;
}

.candy-button--tile {
    width: 300px;
    height: 104px;
    margin: 10px;
}

.candy-button--tile > .candy-button__label {
    font-size: 34px;
    white-space: normal;
    -unity-text-align: middle-center;
    padding: 0 18px;
}

.candy-button--quit {
    margin-top: 20px;
    width: 220px;
}

.tour-fade {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: #FFC9E0;
}

/* ---- Online page: quick match on top, then two clear cards ---- */
.online-panel {
    width: 1320px;
}

.online-cards {
    flex-direction: row;
    justify-content: center;
    align-items: stretch;
    margin-top: 6px;
}

.online-card {
    width: 560px;
    margin: 0 16px;
    padding: 12px 24px 16px 24px;
    border-radius: 36px;
    background-color: rgba(195, 163, 255, 0.16);
    border-width: 4px;
    border-color: rgba(255, 255, 255, 0.9);
    align-items: center;
}

.online-card__title {
    font-size: 36px;
    color: var(--choco);
    -unity-font: url("project://database/Assets/_SugarRush/UI/Fonts/Fredoka-Bold.ttf");
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 8px;
}

.online-card__note {
    font-size: 26px;
    color: var(--lavender-dark);
    -unity-text-align: middle-center;
    white-space: normal;
    min-height: 40px;
    margin: 2px 0 4px 0;
}

.online-card__button {
    width: 360px;
    height: 80px;
    margin-top: 4px;
}

.room-type-row {
    justify-content: center;
}

.room-type {
    width: 220px;
    margin: 0 8px;
    opacity: 0.55;
}

.room-type--on {
    opacity: 1;
    scale: 1.06 1.06;
}

.candy-input > .unity-base-text-field__input--placeholder,
.candy-input > .unity-text-field__input.unity-base-text-field__input--placeholder {
    color: rgba(120, 90, 130, 0.38);
}

.online-panel .candy-input {
    height: 84px;
    margin: 4px 12px;
}

/* ---- HUD mini-map ---- */
.minimap {
    width: 400px;
    height: 330px;
    margin-bottom: 4px;
    border-radius: 40px;
    border-width: 5px;
    border-color: rgba(255, 255, 255, 0.85);
    background-color: rgba(120, 70, 130, 0.45);
}

.minimap--small {
    width: 270px;
    height: 225px;
}

.minimap__dot {
    position: absolute;
    width: 22px;
    height: 22px;
    border-radius: 11px;
    border-width: 3px;
    border-color: #FFFFFF;
}

.minimap__dot--me {
    width: 32px;
    height: 32px;
    border-radius: 16px;
    border-width: 5px;
    border-color: #FFFFFF;
}

.minimap__rubble {
    position: absolute;
    width: 22px;
    height: 22px;
    border-radius: 6px;
    border-width: 3px;
    border-color: #FFE0A8;
    background-color: #5A3020;
    rotate: 45deg;
}

/* ---- Touch controls (phones / tablets) ---- */
.touch-pad {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.touch-group {
    position: absolute;
    bottom: 36px;
    flex-direction: row;
    align-items: flex-end;
}

.touch-group--left {
    left: 40px;
}

.touch-group--right {
    right: 40px;
}

.touch-column {
    margin-right: 22px;
    align-items: center;
}

.touch-button {
    width: 190px;
    height: 190px;
    border-radius: 95px;
    margin: 0 14px;
    align-items: center;
    justify-content: center;
    border-width: 6px;
    border-color: rgba(255, 255, 255, 0.95);
    background-color: rgba(255, 143, 199, 0.55);
    transition-property: scale, background-color;
    transition-duration: 0.08s;
}

.touch-button--down {
    scale: 0.9 0.9;
    background-color: rgba(255, 143, 199, 0.85);
}

.touch-button__label {
    font-size: 40px;
    color: #FFFFFF;
    -unity-font: url("project://database/Assets/_SugarRush/UI/Fonts/Fredoka-Bold.ttf");
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: var(--choco);
}

.touch-button--steer > .touch-button__label {
    font-size: 110px;
    margin-top: -14px;
}

.touch-button--gas {
    width: 230px;
    height: 230px;
    border-radius: 115px;
    background-color: rgba(110, 220, 170, 0.6);
}

.touch-button--brake,
.touch-button--drift {
    width: 150px;
    height: 150px;
    border-radius: 75px;
    margin: 10px 0;
}

.touch-button--brake {
    background-color: rgba(255, 210, 90, 0.6);
}

.touch-button--drift {
    background-color: rgba(170, 140, 255, 0.6);
}

.touch-button__label {
    -unity-text-align: middle-center;
}

.touch-pause {
    position: absolute;
    top: 24px;
    left: 50%;
    translate: -50% 0;
    width: 104px;
    height: 104px;
    border-radius: 52px;
    border-width: 5px;
    border-color: #FFFFFF;
    background-color: rgba(195, 163, 255, 0.7);
    align-items: center;
    justify-content: center;
}

.touch-pause__label {
    font-size: 44px;
    color: #FFFFFF;
    -unity-font: url("project://database/Assets/_SugarRush/UI/Fonts/Fredoka-Bold.ttf");
}

/* Speed and mini-map move up out of the pedals' way. */
.hud--touch .hud-corner--bottom-right {
    bottom: 400px;
}

.hud--touch .minimap {
    width: 250px;
    height: 200px;
}

.rotate-hint {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: #FFC9E0;
    align-items: center;
    justify-content: center;
}

.rotate-hint__text {
    font-size: 64px;
    color: var(--choco);
    -unity-font: url("project://database/Assets/_SugarRush/UI/Fonts/Fredoka-Bold.ttf");
    -unity-text-align: middle-center;
    white-space: normal;
    padding: 0 60px;
}

/* ---- Access code (web) ---- */
.gate-panel {
    width: 900px;
    align-items: center;
}

.gate-prompt {
    font-size: 38px;
    color: var(--choco);
    -unity-font: url("project://database/Assets/_SugarRush/UI/Fonts/Fredoka-Bold.ttf");
    -unity-text-align: middle-center;
    white-space: normal;
    margin: 6px 0 10px 0;
}

.gate-input {
    width: 520px;
}

/* ---- Track picker: main page (over the 3D tour) and waiting room (cream panel) ---- */
.track-picker {
    align-items: center;
    margin: -10px 0 14px 0;
    padding: 2px 18px 6px 18px;
    border-radius: 40px;
    border-width: 4px;
    border-color: rgba(255, 255, 255, 0);
    transition-duration: 0.3s;
    transition-timing-function: ease-out-back;
}

.track-picker:focus {
    background-color: rgba(255, 143, 199, 0.3);
    border-color: var(--pink-light);
    scale: 1.03 1.03;
}

.track-picker__label {
    font-size: 26px;
    color: #FFFFFF;
    -unity-font: url("project://database/Assets/_SugarRush/UI/Fonts/Fredoka-Bold.ttf");
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: var(--lavender-dark);
    margin-bottom: -4px;
}

.track-picker__name {
    min-width: 460px;
}

.track-picker--panel {
    margin: 0 0 8px 0;
}

.track-picker--panel > .track-picker__label {
    color: var(--choco);
    -unity-text-outline-width: 0;
}
